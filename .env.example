# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Authentication & Web App Config
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# Notificaciones por Correo Electrónico (Configuración Externa Opcional)
# Si se configuran, el servidor enviará correos reales a través del proveedor indicado.
# Si se dejan vacíos, los correos se generan y almacenan en la bandeja transaccional local (/api/notifications/email-outbox).
RESEND_API_KEY=""
EMAIL_FROM="notificaciones@publiksolidario.com"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Google Maps Platform (Mapa Interactivo de Establecimientos y Organizaciones)
VITE_GOOGLE_MAPS_API_KEY=""


