rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Reusable Hardened Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Entity Validation Blueprint: User (/users/{userId})
    function isValidUser(data) {
      return data.keys().hasAll([
          'uid',
          'name',
          'email',
          'role',
          'photoURL',
          'organizationName',
          'nitOrId',
          'phone',
          'city',
          'verified',
          'authProvider',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'name',
          'email',
          'role',
          'photoURL',
          'organizationName',
          'nitOrId',
          'phone',
          'city',
          'verified',
          'authProvider',
          'createdAt',
          'updatedAt'
        ]) &&
        data.uid is string &&
        data.uid == request.auth.uid &&
        data.uid.size() >= 1 &&
        data.uid.size() <= 128 &&
        data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.name is string &&
        data.name.size() >= 1 &&
        data.name.size() <= 120 &&
        data.email is string &&
        data.email.size() >= 3 &&
        data.email.size() <= 160 &&
        data.role is string &&
        (data.role == 'buyer' || data.role == 'seller') &&
        data.photoURL is string &&
        data.photoURL.size() <= 1024 &&
        data.organizationName is string &&
        data.organizationName.size() <= 160 &&
        data.nitOrId is string &&
        data.nitOrId.size() <= 60 &&
        data.phone is string &&
        data.phone.size() <= 40 &&
        data.city is string &&
        data.city.size() <= 80 &&
        data.verified is bool &&
        data.authProvider is string &&
        (data.authProvider == 'email' || data.authProvider == 'google') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // 4. Collection Rules: /users/{userId}
    match /users/{userId} {
      // Strictly isolated PII: Only the authenticated document owner can read their own profile
      allow get: if isSignedIn() && isValidId(userId) && isOwner(userId);
      allow list: if false;

      // Creation during registration (email or Google Sign-In)
      allow create: if isSignedIn() &&
        isValidId(userId) &&
        isValidUser(incoming()) &&
        isOwner(userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      // Action-based updates with strict key allowlists and immutable field preservation
      allow update: if isSignedIn() &&
        isValidId(userId) &&
        isValidUser(incoming()) &&
        isOwner(userId) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        incoming().authProvider == existing().authProvider &&
        incoming().updatedAt == request.time && (
          // Action 1: Upgrade Role from Buyer to Seller ("Quiero vender productos")
          (
            existing().role == 'buyer' &&
            incoming().role == 'seller' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['role', 'verified', 'updatedAt'])
          ) ||
          // Action 2: Update User Profile Metadata while keeping role unchanged
          (
            incoming().role == existing().role &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name',
              'photoURL',
              'organizationName',
              'nitOrId',
              'phone',
              'city',
              'verified',
              'updatedAt'
            ])
          )
        );

      allow delete: if false;
    }

    // 5. Products Collection: /products/{productId}
    match /products/{productId} {
      // Catalog Exploration: Public can read active products (buyers, guests, and sellers)
      allow read: if true;

      // Creation: Only authenticated users who are the seller and have role seller
      allow create: if isSignedIn() &&
        incoming().sellerId == request.auth.uid &&
        incoming().sellerRole == 'seller';

      // Updates: Seller can update product details, or users can increment interaction metrics (offersCount, viewsCount)
      allow update: if isSignedIn() && (
        existing().sellerId == request.auth.uid ||
        incoming().diff(existing()).affectedKeys().hasOnly(['offersCount', 'viewsCount'])
      );

      // Delete: Only the owning seller
      allow delete: if isSignedIn() && existing().sellerId == request.auth.uid;
    }

    // 6. Offers Collection: /offers/{offerId}
    match /offers/{offerId} {
      // Real offers: Visible only to the involved buyer or seller
      allow read: if isSignedIn() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid
      );

      // Create: Buyer creates offer linked to a real seller and product
      allow create: if isSignedIn() &&
        incoming().buyerId == request.auth.uid;

      // Update: Buyer or seller can update offer status (accept, reject, counter-offer) or append messages
      allow update: if isSignedIn() && (
        existing().buyerId == request.auth.uid ||
        existing().sellerId == request.auth.uid
      );

      allow delete: if false;
    }

    // 7. Notifications Collection: /notifications/{notificationId}
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // 8. Commissions Collection: /commissions/{commissionId}
    match /commissions/{commissionId} {
      allow read: if isSignedIn() && resource.data.sellerId == request.auth.uid;
      allow create: if isSignedIn() && incoming().sellerId == request.auth.uid;
      allow update, delete: if isSignedIn() && existing().sellerId == request.auth.uid;
    }
  }
}
