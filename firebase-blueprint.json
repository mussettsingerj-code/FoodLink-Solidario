{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and role record associated with Firebase Authentication UID in FoodLink Solidario.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Authentication UID matching the document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Full name of the user or contact person.",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Registered email address of the user.",
          "minLength": 3,
          "maxLength": 160
        },
        "role": {
          "type": "string",
          "description": "Role of the user in the platform (only buyer or seller).",
          "enum": ["buyer", "seller"]
        },
        "photoURL": {
          "type": "string",
          "description": "Profile avatar URL or empty string.",
          "maxLength": 1024
        },
        "organizationName": {
          "type": "string",
          "description": "Organization or establishment name represented by the user.",
          "maxLength": 160
        },
        "nitOrId": {
          "type": "string",
          "description": "Tax ID (NIT) or identification number.",
          "maxLength": 60
        },
        "phone": {
          "type": "string",
          "description": "Contact phone number.",
          "maxLength": 40
        },
        "city": {
          "type": "string",
          "description": "Primary city of operation.",
          "maxLength": 80
        },
        "verified": {
          "type": "boolean",
          "description": "Whether the user's email/account has been verified."
        },
        "authProvider": {
          "type": "string",
          "description": "Authentication provider used by the account.",
          "enum": ["email", "google"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the profile was last updated."
        }
      },
      "required": [
        "uid",
        "name",
        "email",
        "role",
        "photoURL",
        "organizationName",
        "nitOrId",
        "phone",
        "city",
        "verified",
        "authProvider",
        "createdAt",
        "updatedAt"
      ]
    },
    "Product": {
      "title": "Product",
      "description": "Food surplus publication registered by a seller and shared in the public catalog.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique product publication ID matching document ID.",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Product or food surplus batch title.",
          "minLength": 1,
          "maxLength": 180
        },
        "category": {
          "type": "string",
          "description": "Standard FoodLink food category.",
          "maxLength": 60
        },
        "brand": {
          "type": "string",
          "description": "Brand, producer or farm.",
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "description": "Detailed description of the lot and quality conditions.",
          "maxLength": 2000
        },
        "imageUrl": {
          "type": "string",
          "description": "Primary display image URL or data URL.",
          "maxLength": 2048
        },
        "quantity": {
          "type": "number",
          "description": "Total available quantity."
        },
        "unit": {
          "type": "string",
          "description": "Measurement unit (kg, cajas, unidades, etc.).",
          "maxLength": 40
        },
        "condition": {
          "type": "string",
          "description": "Physical/commercial condition of the food items.",
          "maxLength": 80
        },
        "expirationDate": {
          "type": "string",
          "description": "Expiration date in YYYY-MM-DD format.",
          "maxLength": 20
        },
        "recommendedConsumptionDate": {
          "type": "string",
          "description": "Optional recommended consumption date.",
          "maxLength": 40
        },
        "locationCity": {
          "type": "string",
          "description": "City where the batch is located.",
          "maxLength": 80
        },
        "locationAddress": {
          "type": "string",
          "description": "Pickup street address.",
          "maxLength": 200
        },
        "comuna": {
          "type": "string",
          "description": "Administrative Comuna in Medellín, strictly Comuna 8 — Villa Hermosa.",
          "maxLength": 80
        },
        "barrio": {
          "type": "string",
          "description": "Official Barrio of Comuna 8.",
          "enum": [
            "Villa Hermosa",
            "La Mansión",
            "San Miguel",
            "La Ladera",
            "Batallón Girardot",
            "Llanaditas",
            "Los Mangos",
            "Enciso",
            "Sucre",
            "El Pinal",
            "Trece de Noviembre",
            "La Libertad",
            "Villatina",
            "San Antonio",
            "Las Estancias",
            "Villa Turbay",
            "La Sierra",
            "Villa Liliam"
          ]
        },
        "locationReference": {
          "type": "string",
          "description": "Establishment reference or neighborhood landmark.",
          "maxLength": 250
        },
        "requestedPrice": {
          "type": "number",
          "description": "Solidarity price per unit in COP."
        },
        "originalPrice": {
          "type": "number",
          "description": "Commercial reference price in COP."
        },
        "minPurchaseQuantity": {
          "type": "number",
          "description": "Minimum purchase quantity permitted."
        },
        "deliveryConditions": {
          "type": "string",
          "description": "Pickup or delivery guidelines.",
          "maxLength": 400
        },
        "publishedAt": {
          "type": "string",
          "description": "Publication ISO date or timestamp string.",
          "maxLength": 40
        },
        "expiresAt": {
          "type": "string",
          "description": "Expiration ISO date or timestamp string.",
          "maxLength": 40
        },
        "status": {
          "type": "string",
          "description": "Status of the publication.",
          "enum": ["activa", "proxima_a_finalizar", "finalizada", "pausada", "vendida"]
        },
        "sellerId": {
          "type": "string",
          "description": "UID of the publishing seller.",
          "minLength": 1,
          "maxLength": 128
        },
        "sellerName": {
          "type": "string",
          "description": "Name or establishment of the seller.",
          "maxLength": 160
        },
        "sellerType": {
          "type": "string",
          "description": "Establishment type of the seller.",
          "maxLength": 60
        },
        "sellerVerified": {
          "type": "boolean",
          "description": "Whether the seller establishment is verified."
        },
        "offersCount": {
          "type": "number",
          "description": "Number of received offers."
        },
        "viewsCount": {
          "type": "number",
          "description": "Number of times the product was viewed."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Update server timestamp."
        }
      },
      "required": [
        "id",
        "name",
        "category",
        "description",
        "imageUrl",
        "quantity",
        "unit",
        "condition",
        "expirationDate",
        "locationCity",
        "locationAddress",
        "requestedPrice",
        "status",
        "sellerId",
        "sellerName",
        "createdAt",
        "updatedAt"
      ]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "1-on-1 negotiation thread between a buyer and seller regarding a specific food product lot.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique conversation ID matching document ID.",
          "minLength": 1,
          "maxLength": 128
        },
        "productId": {
          "type": "string",
          "description": "ID of the associated product.",
          "minLength": 1,
          "maxLength": 128
        },
        "productName": {
          "type": "string",
          "description": "Name of the associated product.",
          "maxLength": 180
        },
        "productImageUrl": {
          "type": "string",
          "description": "Image URL of the product.",
          "maxLength": 2048
        },
        "sellerId": {
          "type": "string",
          "description": "UID of the seller.",
          "minLength": 1,
          "maxLength": 128
        },
        "sellerName": {
          "type": "string",
          "description": "Name of the seller.",
          "maxLength": 160
        },
        "buyerId": {
          "type": "string",
          "description": "UID of the interested buyer.",
          "minLength": 1,
          "maxLength": 128
        },
        "buyerName": {
          "type": "string",
          "description": "Name of the buyer contact.",
          "maxLength": 160
        },
        "buyerOrganization": {
          "type": "string",
          "description": "Name of the buyer foundation or organization.",
          "maxLength": 160
        },
        "buyerType": {
          "type": "string",
          "description": "Category of the buyer (Fundación, Comprador Mayorista, etc.).",
          "maxLength": 60
        },
        "participants": {
          "type": "array",
          "description": "Array of participant UIDs [buyerId, sellerId].",
          "items": { "type": "string" }
        },
        "status": {
          "type": "string",
          "description": "Current state of the negotiation.",
          "enum": ["pendiente", "en_conversacion", "contraoferta", "aceptada", "rechazada", "finalizada"]
        },
        "requestedQuantity": {
          "type": "number",
          "description": "Quantity proposed in the negotiation."
        },
        "offeredPricePerUnit": {
          "type": "number",
          "description": "Offered unit price in COP."
        },
        "totalOfferedPrice": {
          "type": "number",
          "description": "Total offer sum in COP."
        },
        "unit": {
          "type": "string",
          "description": "Measurement unit.",
          "maxLength": 40
        },
        "pickupMethod": {
          "type": "string",
          "description": "Agreed pickup/transport method.",
          "maxLength": 100
        },
        "proposedDate": {
          "type": "string",
          "description": "Proposed date for food transfer.",
          "maxLength": 40
        },
        "lastMessageText": {
          "type": "string",
          "description": "Preview of the most recent message.",
          "maxLength": 1000
        },
        "lastMessageAt": {
          "type": "string",
          "description": "Timestamp of the last message.",
          "maxLength": 40
        },
        "lastMessageSenderId": {
          "type": "string",
          "description": "UID of the author of the last message.",
          "maxLength": 128
        },
        "unreadCountBuyer": {
          "type": "number",
          "description": "Unread message counter for buyer."
        },
        "unreadCountSeller": {
          "type": "number",
          "description": "Unread message counter for seller."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Update timestamp."
        }
      },
      "required": [
        "id",
        "productId",
        "productName",
        "sellerId",
        "sellerName",
        "buyerId",
        "buyerName",
        "participants",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "Message": {
      "title": "Message",
      "description": "Individual message or structured offer proposal inside a conversation.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique message ID.",
          "minLength": 1,
          "maxLength": 128
        },
        "conversationId": {
          "type": "string",
          "description": "ID of the parent conversation.",
          "minLength": 1,
          "maxLength": 128
        },
        "senderId": {
          "type": "string",
          "description": "UID of the sender.",
          "minLength": 1,
          "maxLength": 128
        },
        "senderName": {
          "type": "string",
          "description": "Display name of the sender.",
          "maxLength": 160
        },
        "senderRole": {
          "type": "string",
          "description": "Sender role in the negotiation (buyer or seller).",
          "enum": ["buyer", "seller"]
        },
        "text": {
          "type": "string",
          "description": "Message content or offer description.",
          "minLength": 1,
          "maxLength": 2000
        },
        "type": {
          "type": "string",
          "description": "Message type.",
          "enum": ["text", "offer", "counteroffer", "acceptance", "rejection"]
        },
        "proposedPrice": {
          "type": "number",
          "description": "Unit price proposed if message is an offer."
        },
        "proposedQuantity": {
          "type": "number",
          "description": "Quantity proposed if message is an offer."
        },
        "unit": {
          "type": "string",
          "description": "Measurement unit.",
          "maxLength": 40
        },
        "read": {
          "type": "boolean",
          "description": "Whether the other participant has read this message."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the message was sent."
        }
      },
      "required": [
        "id",
        "conversationId",
        "senderId",
        "senderName",
        "senderRole",
        "text",
        "type",
        "read",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Stores authenticated user profiles and their active role (buyer or seller)."
    },
    "/products/{productId}": {
      "schema": {
        "$ref": "#/entities/Product"
      },
      "description": "Stores real food surplus publications created by sellers, visible to all users."
    },
    "/conversations/{conversationId}": {
      "schema": {
        "$ref": "#/entities/Conversation"
      },
      "description": "Stores 1-on-1 negotiation threads between buyers and sellers for a specific product."
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/Message"
      },
      "description": "Stores individual chat messages and structured proposals inside a conversation."
    }
  }
}
